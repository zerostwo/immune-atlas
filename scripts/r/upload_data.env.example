ZENODO_USE_SANDBOX=false

# Use ZENODO_TOKEN for production, or ZENODO_SANDBOX_TOKEN when ZENODO_USE_SANDBOX=true
ZENODO_TOKEN=replace-with-your-zenodo-access-token
# ZENODO_SANDBOX_TOKEN=replace-with-your-zenodo-sandbox-token

# Leave empty to create a new draft. Set this to update an existing draft deposition.
ZENODO_DEPOSITION_ID=

# The script only publishes when this is explicitly true.
ZENODO_PUBLISH=false
ZENODO_OVERWRITE_FILES=true

ZENODO_TITLE=immune-atlas source dataset of healthy human immune cells across tissues
ZENODO_VERSION=2026.04.11
ZENODO_PUBLICATION_DATE=2026-04-11
ZENODO_UPLOAD_TYPE=dataset
ZENODO_LANGUAGE=eng
ZENODO_ACCESS_RIGHT=public
ZENODO_LICENSE=cc-by-4.0

# Required. JSON array.
ZENODO_CREATORS_JSON=[{"firstname":"Songqi","lastname":"Duan","affiliations":["City of Hope"],"orcid":"0000-0002-0822-5883"}]

# Optional. JSON array.
ZENODO_CONTRIBUTORS_JSON=[]

# Optional. JSON array.
# Example:
# [{"identifier":"https://github.com/zerostwo/immune-atlas","scheme":"url","relation_type":"isdocumentedby","resource_type":"software"}]
ZENODO_RELATED_IDENTIFIERS_JSON=[{"identifier":"https://github.com/zerostwo/immune-atlas","scheme":"url","relation_type":"isdocumentedby","resource_type":"software"}]

# Optional. JSON array of strings.
ZENODO_KEYWORDS_JSON=["immune-atlas","healthy human immune cells","single-cell RNA-seq","CITE-seq","cross-tissue atlas","rare immune cells","Seurat","BPCells"]

# Optional. If omitted, the script will generate a default HTML description.
ZENODO_DESCRIPTION=

# Optional. If omitted, the script will generate upload notes with file sizes and provenance.
ZENODO_NOTES=
